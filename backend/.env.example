NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://movfit:troque_a_senha@localhost:5432/movfit_gestao
# Alternativa ao DATABASE_URL (usada pela stack Docker):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movfit_gestao
DB_USER=movfit
DB_PASSWORD=troque_a_senha
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5500,https://maicon-movfit.github.io
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=mov-fit---gestao-de-carteira
FIREBASE_SERVICE_ACCOUNT_BASE64=
INTEGRATION_API_KEY=
LOG_LEVEL=info
# Em produção, prefira GOOGLE_APPLICATION_CREDENTIALS apontando para um arquivo fora do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
