        "jsCode": "const entrada = $input.first().json;\nconst headers = entrada.headers || {};\nconst h = Object.fromEntries(Object.entries(headers).map(([k,v]) => [String(k).toLowerCase(), v]));\nconst authorization = String(h.authorization || '');\nconst idToken = authorization.replace(/^Bearer\\s+/i, '').trim();\nconst body = entrada.body || entrada;\nconst action = String(body.action || '').toLowerCase().trim();\nconst unidades = {\n  stmpremium24: 'stm_24h',\n  nrexpress: 'stm_nova_republica',\n  itaituba: 'itaituba',\n  medicilandia: 'medicilandia',\n  novoprogresso: 'novo_progresso'\n};\nreturn [{ json: {\n  preparado: Boolean(idToken && unidades[action]),\n  idToken,\n  action,\n  unidade: unidades[action] || '',\n  empresaId: String(body.empresaId || '1'),\n  tipo: String(body.tipo || 'bi').toLowerCase(),\n  codigoPessoa: body.codigoPessoa == null ? '' : String(body.codigoPessoa)\n} }];"
      },
