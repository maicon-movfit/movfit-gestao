      "parameters": {
        "jsCode": "const resposta = $input.first().json;\nconst req = $('Preparar requisição').first().json;\nconst usuario = Array.isArray(resposta.users) ? resposta.users[0] : null;\nconst permitidos = new Set([\n  'ge.maiconoliveira@gmail.com',\n  'plucassayon@gmail.com',\n  'jssbarroslf@gmail.com',\n  'davidmodesto2015@hotmail.com',\n  'elivelton.veto@gmail.com',\n  'ludymylapsantos@gmail.com'\n]);\nconst email = String(usuario?.email || '').toLowerCase();\nconst autorizado = Boolean(usuario && !usuario.disabled && permitidos.has(email));\nreturn [{ json: { ...req, idToken: undefined, autorizado, uid: usuario?.localId || null, email: email || null } }];"
      },
